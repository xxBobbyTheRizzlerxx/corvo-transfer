{
  "name": "Corvo Transfer",
  "short_name": "Transfer",
  "description": "Send files between any phones, tablets and computers. Free, encrypted, nothing stored.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#12151D",
  "theme_color": "#12151D",
  "icons": [
    { "src": "icon-256.png", "sizes": "256x256", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "files", "accept": ["*/*"] }] }
  }
}
